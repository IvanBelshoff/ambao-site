# Copie para .env e preencha. No GitHub, as mesmas chaves vão em Settings → Secrets and variables → Actions → Variables.

# Endereço público do site, sem barra no fim. A prévia do LinkedIn precisa dele absoluto.
SITE_URL=https://ambao.silexcode.com.br

# Canais de contato. Vazio esconde o botão daquele canal no site publicado.
# WhatsApp com DDD; o 55 e a máscara são opcionais. Exemplo: 27999998888
WHATSAPP_NUMBER=
EMAIL_USER=
# Endereços completos dos perfis.
PROFILE_LINKEDIN=
PROFILE_GITHUB=

# Website ID do Umami (cloud.umami.is), que conta visitas e cliques de contato. Vazio desliga.
UMAMI_WEBSITE_ID=
